<div class="item-list">
<% for (const item of items) { %>
<div class="item">
<span class="item-aside"><span class="outlet-tag"><%- item.outlet %></span><span class="item-meta"><%- item.date %></span></span>
<div class="item-body">
<span class="item-title"><a href="<%- item.url %>"><%- item.title %></a></span>
<% if (item.archived) { %><span class="item-meta">archived copy</span><% } %>
</div>
</div>
<% } %>
</div>
